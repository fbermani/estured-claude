# EstuRed — Variables de entorno
# Copiar a .env.local y completar. NUNCA commitear .env.local.
# Convención oficial: docs/15_ENVIRONMENT_AND_SETUP.md

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EstuRed

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server-side. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Selector de sesión simulada — SOLO desarrollo local. NUNCA en Vercel.
# Crear los usuarios con: node --env-file=.env.local scripts/seed-demo-users.mjs
DEMO_LOGIN_ENABLED=
DEMO_USERS_PASSWORD=

# Protege /api/cron/expire-stale-records (docs/07 §31, migración 0013).
# Generar un valor random (ej. `openssl rand -hex 32`) y usar el mismo
# valor acá y en el `cron.schedule` de la migración 0013.
CRON_SECRET=

# Geocodificador (Nominatim/OSM, DF6). Opcional, solo server. Identifica a la app ante Nominatim.
# Ej.: EstuRed/1.0 (contacto@tu-dominio.com)
GEOCODER_USER_AGENT=

# Emails (Resend). Sin EMAIL_FROM se usa el remitente sandbox (solo entrega al dueño de la cuenta Resend).
RESEND_API_KEY=
# Producción: dirección de un dominio VERIFICADO en Resend, solo la dirección (ej. no-reply@tudominio.com).
EMAIL_FROM=
# Poner "true" SOLO cuando el dominio esté verificado: habilita los mails de avisos de llegada y confirmación del familiar.
EMAIL_DOMAIN_VERIFIED=
# URL pública del sitio (arma los enlaces de los mails). Por defecto https://estured.com
NEXT_PUBLIC_SITE_URL=

# Preapertura (DR42, docs/23): "on" enciende la capa de preapertura. Dejar vacío para el comportamiento normal.
PREAPERTURA=
# Fecha y hora de cierre de la convocatoria de Residencias fundadoras (ISO 8601, p. ej. 2026-12-15T23:59:00-03:00).
# Vacía = no se muestra cuenta regresiva ni se inventa una fecha. Pasada la fecha, la pantalla de fundadoras dice «cerró».
FOUNDERS_CLOSE_AT=

# Cloudflare Turnstile (CAPTCHA en login, registro, preregistro, recuperar contraseña y waitlist).
# En dev usá las claves de prueba de Cloudflare (siempre pasan): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA.
# En producción, las claves reales del widget (dashboard de Cloudflare > Turnstile). Sin secret: dev deja pasar, prod rechaza.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
